{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@workspace/web/*": ["../../packages/ui/web/src/*"],
      "@workspace/web/variants/*": ["../../packages/ui/web/src/shared/variants/*"],
      "@workspace/web/types/*": ["../../packages/ui/web/src/shared/types/*"],
      "@workspace/web/utils": ["../../packages/ui/web/src/shared/utils/utils.ts"],
      "@workspace/web/utils/*": ["../../packages/ui/web/src/shared/utils/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
