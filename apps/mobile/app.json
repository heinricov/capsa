{
  "expo": {
    "name": "Mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../packages/public/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "../../packages/public/android-icon-foreground.png",
        "backgroundImage": "../../packages/public/android-icon-background.png",
        "monochromeImage": "../../packages/public/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "../../packages/public/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
