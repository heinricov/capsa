# Salin file ini ke .env (root repo) — .env tidak ikut di-commit.
#   cp .env.example .env
# Lalu ganti JWT_SECRET dengan hasil: openssl rand -hex 32

# --- Server ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres@localhost:5432/capsa"
JWT_SECRET="ganti-dengan-hasil-openssl-rand-hex-32"
PORT=4000

# --- Web (Next.js) --------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Capsa"

# --- Mobile (Expo/Metro) ---------------------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_APP_NAME="Capsa"

# --- Opsional -------------------------------------------------------------
# Format log pino: pretty (dev, default) atau json (production/log aggregator).
# LOG_FORMAT=pretty
# SKIP_ENV_VALIDATION=1
