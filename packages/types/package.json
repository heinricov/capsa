{
  "name": "@workspace/types",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./account": {
      "types": "./src/account.ts",
      "default": "./src/account.ts"
    },
    "./common": {
      "types": "./src/common.ts",
      "default": "./src/common.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "typescript": "^5"
  }
}
